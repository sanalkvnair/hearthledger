# Copy to .env and fill in. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# required: generate with `openssl rand -hex 32`
JWT_SECRET=
POSTGRES_PASSWORD=hearthledger
PUBLIC_URL=http://localhost:8081
# Behind HTTPS (e.g. Cloudflare Tunnel) set COOKIE_SECURE=true and PUBLIC_URL=https://your.host
COOKIE_SECURE=false
# Optional: Cloudflare Tunnel token, run with `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: PDF statement import (any OpenAI-compatible API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
