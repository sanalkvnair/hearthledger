# Copy to .env and fill in. Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${PUBLIC_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
POSTGRES_PASSWORD=familybudget
PUBLIC_URL=http://localhost:8081

# Optional: PDF statement import (any OpenAI-compatible API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
